# Copy to .env for local development. Never commit real values.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
APP_URL="http://localhost:3000"
# Production only (managed identity is used for Blob Storage; no keys needed):
AZURE_STORAGE_ACCOUNT_NAME=""
AZURE_STORAGE_CONTAINER_NAME="product-images"
# Used only by `npm run admin:create` (prompted if unset). Do not store in the app settings.
# ADMIN_EMAIL=""
